# ════════════════════════════════════════════════════════════════════
# FORK / HowManyCalories — environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored
# and never committed; this template is checked in so a fresh clone
# knows what to set.
#
# Most variables have sensible dev defaults baked into config.py — only
# ANTHROPIC_API_KEY is strictly required for the AI pipeline to work.
# Everything else can be left out in development.
# ════════════════════════════════════════════════════════════════════


# ── AI pipeline ────────────────────────────────────────────────────────
# Anthropic key for Claude vision + judge. Required.
ANTHROPIC_API_KEY=

# Optional — model overrides. Defaults are claude-sonnet-4-6 (vision)
# and claude-opus-4-6 (judge).
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_JUDGE_MODEL=claude-opus-4-6


# ── Nutrition data ─────────────────────────────────────────────────────
# USDA FoodData Central key. Falls back to DEMO_KEY if unset (rate-
# limited but works for development).
USDA_API_KEY=


# ── Environment + storage ──────────────────────────────────────────────
ENV=dev
# DB_PATH=./data/scans.db


# ── Auth / sessions ────────────────────────────────────────────────────
# Seed admin passwords. In dev these default to 1363 if unset, so you
# can log in as `admin` or `0` immediately. In prod, leave unset and
# create the first admin via direct DB insertion or a one-shot script
# rather than committing a known credential.
SEED_ADMIN_PASSWORD=
SEED_SUPERADMIN_PASSWORD=

# Cookie + session knobs. Leave defaults unless you know what you want.
# SESSION_LIFETIME_DAYS=30
# SESSION_COOKIE_NAME=fork_session
# SESSION_COOKIE_SAMESITE=lax


# ── Per-user limits ────────────────────────────────────────────────────
# Set to 0 to disable. Admins are exempt.
MAX_SCANS_PER_USER_PER_DAY=20

# Per-process daily cap on Stage-3-judge / day-quality LLM calls.
DAY_QUALITY_DAILY_CAP=1000


# ── 152-ФЗ legal / consent (Phase 1) ───────────────────────────────────
# Operator name + city rendered into /privacy and /terms. Replace the
# placeholders with your actual ФИО + город before going live.
OPERATOR_NAME=Иванов Иван Иванович
OPERATOR_CITY=Москва

# Bumped when the privacy policy materially changes — re-prompts users.
CONSENT_VERSION_CURRENT=v1.2026-05


# ── Email infrastructure (Phase 2) ─────────────────────────────────────
# How emails actually go out:
#   log — dev default, writes email payload to stderr instead of sending
#   api — real send via Unisender Go REST API
EMAIL_TRANSPORT=log

# Unisender Go API key — REQUIRED if EMAIL_TRANSPORT=api. Treat as a
# secret. Never commit this file with a real value. If a key is ever
# pasted into chat / logs / git history, rotate it immediately.
UNISENDER_API_KEY=

# The transactional endpoint. Default is Unisender Go (purpose-built
# for transactional email). Change only if you signed up for the
# legacy/standard Unisender product instead.
# UNISENDER_API_ENDPOINT=https://go1.unisender.ru/ru/transactional/api/v1/email/send.json

# Sender identity. Domain must have SPF/DKIM configured at Unisender
# before the email reaches inboxes reliably (Phase 4 deploy task).
UNISENDER_FROM_EMAIL=noreply@myfork.ru
UNISENDER_FROM_NAME=FORK

# Token lifetimes (seconds).
# EMAIL_CONFIRM_TOKEN_TTL_SEC=86400  # 24h
# EMAIL_RESET_TOKEN_TTL_SEC=3600     # 1h

# Public base URL — used to build links inside emails. Set to your
# real domain in production (https://myfork.ru) so links land where
# they should after the Phase 4 deploy.
APP_BASE_URL=http://localhost:8000


# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated origins. Wide-open ("*") is allowed only in dev.
# In production set to https://myfork.ru
# CORS_ORIGINS=
